<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UNI.Hud.Widget</RootNamespace>
    <AssemblyName>UNI.Hud.Widget</AssemblyName>
    <Version>0.2.0</Version>
    <AssemblyTitle>UNI HUD</AssemblyTitle>
    <Company>solutionwright</Company>
    <Product>UNI HUD</Product>
    <Description>UNI HUD — always-on-top native Windows widget. Docks to screen edge, minimizes to tray, hotkey Ctrl+Shift+H toggle. Reads http://127.0.0.1:8100/api/hud/snapshot.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
