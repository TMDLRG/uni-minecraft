# /etc/containers/systemd/uni-bcast-pubgate.container
# UNI Production Platform - the ONE-URL camera gateway (System 2). 2026-07-12.
# Serves pub.html (pick device + slot) over HTTPS :8443 and same-origin-proxies the WHIP
# handshake to the relay's WebRTC listener. Media then flows browser -> relay :8189/udp (ICE).
# The proxy whitelists cam1..cam10 ONLY - the program path can never be published through here.
[Unit]
Description=UNI Camera Gateway (one-URL source picker -> WHIP publish to the relay)
After=podman.socket network-online.target
Wants=podman.socket
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
Image=localhost/uni-bcast-pubgate:latest
ContainerName=uni-bcast-pubgate
PublishPort=8443:8443
Volume=/var/lib/uni/broadcast/certs:/certs:ro
Environment=MTX_URL=https://10.88.0.1:8889

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
